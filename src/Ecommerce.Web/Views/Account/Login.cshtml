@model LoginVm
@{ViewData["Title"]=Model.Admin?"Staff sign in":"Sign in";}
<div class="auth"><span class="eyebrow">@(Model.Admin?"ERP WORKSPACE":"WELCOME BACK")</span><h1>@ViewData["Title"]</h1><form method="post"><div asp-validation-summary="All" class="validation"></div><input asp-for="Admin" type="hidden"/><label asp-for="Email">Email or mobile</label><input asp-for="Email" autocomplete="username"/><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password"/><button>Sign in →</button></form><p>New customer? <a href="/account/register">Create an account</a></p><p><a href="/account/forgot">Forgot password?</a></p><a href="/account/login?admin=@(!Model.Admin)">@(Model.Admin?"Customer login":"Staff login")</a></div>
