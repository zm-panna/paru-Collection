@model Microsoft.AspNetCore.Identity.IdentityUser
<h1>My account</h1><p>Store credit balance: BDT @ViewBag.StoreCredit</p><p>@Model.Email · @Model.PhoneNumber</p><nav class="tabs"><a href="/orders">My orders</a><a href="/customer/wishlist">Wishlist</a><a href="/customer/support">Support tickets</a><a href="/assistant">AI assistant</a><a href="/admin">Staff dashboard</a></nav><div class="two-col"><section class="panel"><h2>Address book</h2>@foreach(Address a in ViewBag.Addresses){<details><summary>@a.Recipient · @a.Street @(a.IsDefault?"· Default":"")</summary><form method="post" action="/account/address-update">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@a.Id"/><input name="recipient" value="@a.Recipient" required/><input name="phone" value="@a.Phone" required/><input name="street" value="@a.Street" required/><input name="district" value="@a.District"/><input name="area" value="@a.Area"/><label><input name="isDefault" type="checkbox" value="true" checked="@a.IsDefault"/>Default address</label><button>Update</button></form><form method="post" action="/account/address-delete">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@a.Id"/><button>Delete address</button></form></details>}<form action="/account/address" method="post">@Html.AntiForgeryToken()<input name="Recipient" placeholder="Recipient name" required/><input name="Phone" placeholder="Mobile" required/><input name="Street" placeholder="Street / house" required/><input name="Area" placeholder="Area"/><input name="District" placeholder="District"/><button>Save address</button></form></section><section class="panel"><h2>Change password</h2><form action="/account/password" method="post">@Html.AntiForgeryToken()<input name="currentPassword" type="password" placeholder="Current password" required/><input name="newPassword" type="password" placeholder="New password" required/><button>Update password</button></form><h2>Notifications</h2>@foreach(Notification n in ViewBag.Notifications){<p>@n.Message <small>@n.CreatedAt.ToString("g") UTC</small></p>}</section></div>
