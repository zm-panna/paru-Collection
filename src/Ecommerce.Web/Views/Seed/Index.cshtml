@{
    ViewData["Title"] = "Database Seed";
}

<div class="container mt-4">

    <h2>Database Seed</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card">
        <div class="card-body">

            <p>
                This will check and update Roles, Admin permissions,
                Menu and MenuItem records.
            </p>

            <form asp-controller="Seed"
                  asp-action="Run"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-primary">
                    Run Database Seed
                </button>

            </form>

        </div>
    </div>

</div>