@model CheckoutVm
<h1>Review your order</h1><div class="panel"><p><strong>@Model.Name</strong> · @Model.Phone<br/>@Model.Address</p><table><tr><th>Product</th><th>Quantity</th><th>Price</th></tr>@foreach(CartItem c in ViewBag.Cart){<tr><td>@c.Sku.Product.Name · @c.Sku.Name</td><td>@c.Quantity</td><td>BDT @c.Sku.SalePrice</td></tr>}</table><p>Subtotal: @ViewBag.Subtotal · Discount: @ViewBag.Discount · VAT: @ViewBag.Tax · Shipping: @ViewBag.Shipping</p><h2>Total BDT @ViewBag.Total</h2><p>Payment: @Model.Method</p><form method="post" action="/checkout">@Html.AntiForgeryToken()<input asp-for="Name" type="hidden"/><input asp-for="Phone" type="hidden"/><input asp-for="Email" type="hidden"/><input asp-for="Address" type="hidden"/><input asp-for="ZoneId" type="hidden"/><input asp-for="Coupon" type="hidden"/><input asp-for="Method" type="hidden"/><input asp-for="Key" type="hidden"/><button>Confirm and place order</button></form><p class="muted">Availability and prices are rechecked when the order is placed.</p><a href="/checkout">Edit delivery details</a></div>
