@model CheckoutVm
<h1>Checkout</h1>@if(User.Identity?.IsAuthenticated!=true||User.HasClaim("GuestCheckout","true")){<p class="panel">Guest checkout is available. Your order is accessible in this browser session. <a href="/account/login">Sign in before ordering</a> to keep it in your existing account. Entering an email does not link an existing account.</p>}<div class="two-col"><form method="post" action="/checkout/review" class="panel">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div><input asp-for="Key" type="hidden"/><h2>Delivery details</h2><label asp-for="Name"></label><input asp-for="Name"/><label asp-for="Phone"></label><input asp-for="Phone"/><label asp-for="Email"></label><input asp-for="Email"/><label asp-for="Address"></label><textarea asp-for="Address"></textarea><label>Delivery zone</label><select asp-for="ZoneId">@foreach(DeliveryZone z in ViewBag.Zones){<option value="@z.Id">@z.Name · BDT @z.Charge</option>}</select><label asp-for="Coupon"></label><input asp-for="Coupon"/><label>Payment method</label><select asp-for="Method"><option value="COD">Cash on delivery</option><option value="StoreCredit">Store credit (full balance required)</option>@if(ViewBag.SSL==true){<option value="SSLCommerz">SSLCommerz — Card / MFS</option>}</select><button>Review order →</button></form><aside class="panel"><h2>Before you order</h2><p>Current prices, stock, discounts, taxes and shipping will be validated on the server.</p><p>You can review the final invoice and pay online from your order page.</p><p>Need help? <a href="/assistant">Ask the assistant</a></p></aside></div>
