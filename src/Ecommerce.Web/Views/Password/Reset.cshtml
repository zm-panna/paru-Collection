<div class="auth"><h1>Choose a new password</h1><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div><input type="hidden" name="email" value="@ViewBag.Email"/><input type="hidden" name="token" value="@ViewBag.Token"/><label>New password</label><input type="password" name="password" minlength="12" required/><button>Reset password</button></form></div>
