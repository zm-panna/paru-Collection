@model List<ReturnRequest>
@{Layout="_AdminLayout";}
<h1>Returns & refunds</h1>@foreach(var r in Model){<section class="panel"><h3>@r.Order.Number · @r.OrderLine.Name × @r.Quantity</h3><p>@r.Reason · @r.Status</p>@if(r.Status=="Requested"){<form action="/admin/operations/inspect" method="post">@Html.AntiForgeryToken()<input name="id" value="@r.Id" type="hidden"/><select name="accept"><option value="true">Accept after receiving goods</option><option value="false">Reject</option></select><label><input name="restock" type="checkbox" value="true"/> Inspected goods may be returned to stock</label><textarea name="note" required placeholder="Inspection result"></textarea><button>Record inspection</button></form>}</section>}
<h2>Refund queue</h2><p>Complete refunds using your merchant portal or cash process, then record the verified reference below. This action records accounting; it does not send money.</p>@foreach(PaymentRefund r in ViewBag.Refunds){<section class="panel"><strong>@r.Order.Number · BDT @r.Amount · @r.Status</strong><p>@r.Reason</p>@if(r.Status=="Requested"){<form class="inline" action="/admin/operations/refund" method="post">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@r.Id"/><input name="externalReference" required placeholder="Verified refund reference"/><button>Record completed refund</button></form>}else{<p>@r.ExternalReference</p>}</section>}

<h2>SSLCommerz refund execution</h2><p>Requires merchant refund permission and RefundEnabled configuration. Submit once, then query. Uncertain submissions must be reconciled in the merchant portal.</p>@foreach(PaymentRefund r in ViewBag.Refunds){if(r.Status is "Requested" or "Processing"){<form method="post" action="/admin/finance/@(r.Status=="Requested"?"refund-start":"refund-query")" class="panel">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@r.Id"/><span>@r.Order.Number · @r.Amount · @r.Status</span><button>@(r.Status=="Requested"?"Submit online refund":"Verify gateway refund status")</button></form>}}

@foreach(PaymentRefund r in ViewBag.Refunds){if(r.Status=="Requested"){<form method="post" action="/admin/finance/store-credit">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@r.Id"/><button>Convert refund BDT @r.Amount to customer store credit</button></form>}}

<h2>Replacement / different-item exchange</h2><p>Choose another SKU and quantity to exchange. A lower total becomes store credit. Collect any higher total difference in cash and enter the verified receipt. No charge is sent automatically.</p>@foreach(var r in Model.Where(x=>x.Status=="Accepted")){<form action="/admin/operations/replacement" method="post" class="panel inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id"/><span>@r.Order.Number · @r.OrderLine.Name × @r.Quantity</span><label>Replacement SKU (blank keeps original)</label><select name="targetSkuId"><option value="">Original SKU</option>@foreach(ProductSku sku in ViewBag.Skus){<option value="@sku.Id">@sku.SKU · @sku.SalePrice</option>}</select><label>Quantity</label><input type="number" name="targetQuantity" value="@r.Quantity" min="1"/><label>Cash difference collected</label><input type="number" name="collectedDifference" value="0" min="0" step="0.01"/><label>Cash receipt reference</label><input name="collectionReference" maxlength="100"/><button>Create replacement</button></form>}
