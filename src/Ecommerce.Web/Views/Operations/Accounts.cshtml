@model List<Journal>
@{Layout="_AdminLayout";}
<h1>Accounts & expenses</h1><div class="two-col"><details class="panel"><summary>Post balanced journal</summary><form action="/admin/operations/journal" method="post">@Html.AntiForgeryToken()<input name="description" required placeholder="Description"/><div id="journal-lines">@for(int i=0;i<2;i++){<div class="line-row"><select name="code">@foreach(AccountHead a in ViewBag.Heads){<option value="@a.Code">@a.Code @a.Name</option>}</select><input name="debit" type="number" step="0.01" min="0" value="0" aria-label="Debit"/><input name="credit" type="number" step="0.01" min="0" value="0" aria-label="Credit"/></div>}</div><button type="button" class="outline" data-clone="journal-lines">Add line</button><button>Post journal</button></form></details><details class="panel"><summary>Create expense</summary><form action="/admin/operations/expense" method="post">@Html.AntiForgeryToken()<label>Category</label><select name="categoryId">@foreach(ExpenseCategory c in ViewBag.Categories){<option value="@c.Id">@c.Name</option>}</select><label>Branch</label><select name="branchId">@foreach(Branch b in ViewBag.Branches){<option value="@b.Id">@b.Name</option>}</select><input name="description" required placeholder="Description"/><select name="paymentMethod"><option>Cash</option><option>Bank</option></select><input name="amount" type="number" min="0.01" step="0.01" required/><button>Save expense draft</button></form></details></div>
<h2>Expense approval</h2>@foreach(Expense e in ViewBag.Expenses){<div class="panel inline"><span>@e.ExpenseCategory.Name · @e.Description · BDT @e.Amount · @e.Status</span>@if(e.Status=="Draft"){<form action="/admin/operations/expense-pay" method="post">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@e.Id"/><button>Approve & pay cash</button></form>}</div>}
<h2>Journal register</h2>@foreach(var j in Model){<details class="panel"><summary>@j.Date.ToString("yyyy-MM-dd") · @j.Description · @j.Reference</summary><table><tr><th>Account</th><th>Debit</th><th>Credit</th><th>Party</th></tr>@foreach(var l in j.Lines){<tr><td>@l.AccountHead.Code @l.AccountHead.Name</td><td>@l.Debit</td><td>@l.Credit</td><td>@l.Party</td></tr>}</table></details>}

<h2>Expense attachments</h2>@foreach(Expense e in ViewBag.Expenses){<section class="panel"><p>@e.Description · @e.PaymentMethod</p>@if(!string.IsNullOrEmpty(e.AttachmentPath)){<a href="/admin/expense-files/@e.Id">View receipt</a>}@if(e.Status=="Draft"){<form method="post" action="/admin/expense-files/upload" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"/><input type="file" name="file" accept="application/pdf,image/png,image/jpeg" required/><button>Attach receipt</button></form>}</section>}
