@model List<StockBalance>
@{Layout="_AdminLayout";}
<h1>Inventory</h1><div class="two-col"><form class="panel" action="/admin/operations/adjust" method="post">@Html.AntiForgeryToken()<h2>Opening / adjustment / damage</h2><label>Warehouse</label><select name="warehouseId">@foreach(Warehouse w in ViewBag.Warehouses){<option value="@w.Id">@w.Name</option>}</select><label>SKU</label><select name="skuId">@foreach(ProductSku s in ViewBag.Skus){<option value="@s.Id">@s.SKU · @s.Name</option>}</select><label>Quantity change (negative for damage)</label><input name="quantity" type="number" required/><input name="reason" placeholder="Reason and reference" required/><button>Post stock adjustment</button></form><form class="panel" action="/admin/operations/transfer" method="post">@Html.AntiForgeryToken()<h2>Warehouse transfer</h2><label>From</label><select name="from">@foreach(Warehouse w in ViewBag.Warehouses){<option value="@w.Id">@w.Name</option>}</select><label>To</label><select name="to">@foreach(Warehouse w in ViewBag.Warehouses){<option value="@w.Id">@w.Name</option>}</select><label>SKU</label><select name="skuId">@foreach(ProductSku s in ViewBag.Skus){<option value="@s.Id">@s.SKU · @s.Name</option>}</select><input name="quantity" type="number" min="1" value="1"/><button>Transfer stock</button></form></div><div class="table-wrap"><table><tr><th>Warehouse</th><th>SKU</th><th>On hand</th><th>Reserved</th><th>Available</th><th>Alert</th></tr>@foreach(var s in Model){<tr><td>@s.Warehouse.Name</td><td>@s.Sku.SKU</td><td>@s.OnHand</td><td>@s.Reserved</td><td>@(s.OnHand-s.Reserved)</td><td>@(s.OnHand-s.Reserved<=s.Sku.ReorderLevel?"Reorder":"Healthy")</td></tr>}</table></div>

<h2>Store inventory locations</h2><p>Each new store below receives a dedicated warehouse location. Transfer stock to that location to maintain an independent balance. Existing mapped stores retain their location and stock.</p><form method="post" action="/admin/operations/store" class="panel">@Html.AntiForgeryToken()<label>Store name</label><input name="name" maxlength="160" required/><label>Branch</label><select name="branchId">@foreach(Branch b in ViewBag.Branches){<option value="@b.Id">@b.Name</option>}</select><button>Create store with independent inventory</button></form>@foreach(Store s in ViewBag.Stores){<p>@s.Name → @s.Warehouse.Name <a href="/admin/reports/stock?warehouseId=@s.WarehouseId">View store stock</a></p>}
