@model List<Order>
@{Layout="_AdminLayout";}
<h1>Orders & delivery</h1><p class="muted">Latest 100 orders. Every status transition is validated and recorded.</p>@foreach(var o in Model){<details class="panel"><summary><strong>@o.Number</strong> · @o.CustomerName · BDT @o.Total · <span class="status">@o.Status</span> · @o.PaymentStatus</summary><p>@o.Phone · @o.ShippingAddress</p><ul>@foreach(var l in o.Lines){<li>@l.Name × @l.Quantity</li>}</ul><div class="form-grid"><form action="/admin/operations/status" method="post">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@o.Id"/><label>Next status</label><select name="status">@foreach(var s in Enum.GetValues<OrderStatus>().Where(x=>CommerceRules.CanTransition(o.Status,x))){<option value="@s">@s</option>}</select><button>Update status</button></form><form action="/admin/operations/delivery" method="post">@Html.AntiForgeryToken()<input name="orderId" type="hidden" value="@o.Id"/><label>Delivery agent</label><select name="agentId"><option value="">Unassigned</option>@foreach(DeliveryAgent a in ViewBag.Agents){<option value="@a.Id">@a.Name</option>}</select><input name="trackingNumber" placeholder="Courier tracking number"/><button>Assign delivery</button></form>@if(o.PaymentMethod=="COD"&&o.PaymentStatus!="Paid"&&(o.Status==OrderStatus.Delivered||o.Status==OrderStatus.Returned)){<form action="/admin/operations/collect" method="post">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@o.Id"/><input type="hidden" name="amount" value="@(((Dictionary<Guid,decimal>)ViewBag.CodDues).GetValueOrDefault(o.Id))"/><p>Confirm cash received: BDT @(((Dictionary<Guid,decimal>)ViewBag.CodDues).GetValueOrDefault(o.Id)) after accepted returns.</p><button>Record COD collection</button></form>}</div></details>}

<h2>Courier tracking</h2>@foreach(Delivery d in ViewBag.Deliveries){<form action="/admin/operations/delivery-status" method="post" class="panel inline">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@d.Id"/><strong>@d.Order.Number · @d.Status</strong><select name="status">@foreach(var s in new[]{"PickedUp","InTransit","OutForDelivery","Delivered"}){<option>@s</option>}</select><input name="note" placeholder="Tracking note" maxlength="1000"/><button>Update tracking</button></form>}
