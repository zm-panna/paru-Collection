@model List<SupportTicket>
@{Layout="_AdminLayout";}
<h1>Support desk & review moderation</h1>@foreach(var t in Model){<details class="panel"><summary>@t.Subject · @t.Status</summary><p>@t.Message</p><form method="post" action="/admin/operations/support">@Html.AntiForgeryToken()<input name="id" value="@t.Id" type="hidden"/><select name="status"><option>Open</option><option>In Progress</option><option>Resolved</option><option>Closed</option></select><textarea name="response">@t.Response</textarea><button>Update ticket</button></form></details>}<h2>Reviews</h2>@foreach(Review r in ViewBag.Reviews){<div class="panel"><strong>@r.Product.Name · @r.Rating / 5 · @(r.Approved?"Published":"Hidden")</strong><p>@r.Comment</p><form method="post" action="/admin/operations/review">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@r.Id"/><select name="approve"><option value="true">Approve</option><option value="false">Hide / reject</option></select><button>Apply</button></form></div>}
