@model List<PurchaseOrder>
@{Layout="_AdminLayout";}
<h1>Purchasing</h1><details class="panel"><summary>Create purchase order</summary><form action="/admin/operations/purchase" method="post">@Html.AntiForgeryToken()<div class="two-col"><div><label>Supplier</label><select name="supplierId">@foreach(Supplier s in ViewBag.Suppliers){<option value="@s.Id">@s.Name</option>}</select></div><div><label>Warehouse</label><select name="warehouseId">@foreach(Warehouse w in ViewBag.Warehouses){<option value="@w.Id">@w.Name</option>}</select></div></div><div id="purchase-lines"><div class="line-row"><select name="skuId">@foreach(ProductSku s in ViewBag.Skus){<option value="@s.Id">@s.SKU · @s.Name</option>}</select><input name="quantity" type="number" min="1" value="1" aria-label="Quantity"/><input name="cost" type="number" step="0.01" min="0" placeholder="Unit cost" required/></div></div><button type="button" class="outline" data-clone="purchase-lines">Add line +</button><button>Create draft</button></form></details>
@foreach(var p in Model){<details class="panel"><summary><strong>@p.Number</strong> · @p.Supplier.Name · @p.Status · BDT @p.Total.ToString("N2")</summary><table><tr><th>SKU</th><th>Qty</th><th>Cost</th></tr>@foreach(var l in p.Lines){<tr><td>@l.Sku.SKU</td><td>@l.Quantity</td><td>@l.UnitCost</td></tr>}</table><p>Paid: @p.Paid · Due: @(p.ReceivedTotal-p.ReturnedTotal-p.Paid)</p><div class="inline">@if(p.Status=="Draft"){<form action="/admin/operations/approve" method="post">@Html.AntiForgeryToken()<input name="id" value="@p.Id" type="hidden"/><button>Approve</button></form>}@if(p.Status=="Approved"){<form action="/admin/operations/receive" method="post">@Html.AntiForgeryToken()<input name="id" value="@p.Id" type="hidden"/><button>Receive goods</button></form>}@if((p.Status=="Received"||p.Status=="PartReceived")&&p.Paid<p.ReceivedTotal-p.ReturnedTotal){<form action="/admin/operations/supplier-payment" method="post" class="inline">@Html.AntiForgeryToken()<input name="id" value="@p.Id" type="hidden"/><input name="amount" type="number" min="0.01" step="0.01" max="@(p.ReceivedTotal-p.ReturnedTotal-p.Paid)" required/><button>Pay supplier from cash</button></form>}</div></details>}

<h2>Supplier invoices</h2><p>Record the supplier document against received quantities, then approve it before paying. Inventory and payable accounting is posted at receipt and is not posted again on invoice approval.</p>
@foreach(var p in Model.Where(x=>x.Status is "Received" or "PartReceived")){<details class="panel"><summary>Invoice received goods · @p.Number</summary><form method="post" action="/admin/operations/supplier-invoice">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><label>Supplier invoice number</label><input name="number" maxlength="100" required/><label>Invoice date</label><input name="invoiceDate" type="date" required value="@DateTime.UtcNow.ToString("yyyy-MM-dd")"/><label>Due date</label><input name="dueDate" type="date" required value="@DateTime.UtcNow.ToString("yyyy-MM-dd")"/>@foreach(var l in p.Lines){<label>@l.Sku.SKU · received @l.ReceivedQuantity · unit cost @l.UnitCost</label><input type="hidden" name="lineId" value="@l.Id"/><input name="quantity" type="number" min="0" max="@l.ReceivedQuantity" value="0"/>}<button>Create matched draft invoice</button></form></details>}
@foreach(SupplierInvoice i in ViewBag.Invoices){<section class="panel"><h3>@i.Number · @i.PurchaseOrder.Number</h3><p>@i.Status · total @i.Total · due @i.DueDate.ToString("yyyy-MM-dd")</p>@if(i.Status=="Draft"){<form method="post" action="/admin/operations/invoice-approve">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@i.Id"/><button>Approve invoice</button></form><form method="post" action="/admin/operations/invoice-void">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@i.Id"/><button>Void draft</button></form>}</section>}
