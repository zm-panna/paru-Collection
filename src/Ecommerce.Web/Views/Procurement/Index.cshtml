@model List<PurchaseRequisition>
@{Layout="_AdminLayout";var quotes=(List<SupplierQuotation>)ViewBag.Quotes;}
<h1>Procurement & receiving</h1><details class="panel"><summary>New requisition</summary><form method="post" action="/admin/procurement/request">@Html.AntiForgeryToken()<label>Warehouse</label><select name="warehouse">@foreach(Warehouse w in ViewBag.Warehouses){<option value="@w.Id">@w.Name</option>}</select><input name="purpose" required placeholder="Purpose"/><div id="request-lines"><div class="line-row"><select name="sku">@foreach(ProductSku s in ViewBag.Skus){<option value="@s.Id">@s.SKU @s.Name</option>}</select><input name="quantity" min="1" type="number" value="1"/></div></div><button type="button" data-clone="request-lines">Add line</button><button>Save requisition</button></form></details>
@foreach(var r in Model){<details class="panel"><summary>@r.Number · @r.Purpose · @r.Status</summary><ul>@foreach(var l in r.Lines){<li>@l.Sku.SKU × @l.Quantity</li>}</ul>@if(r.Status=="Draft"){<form method="post" action="/admin/procurement/approve">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@r.Id"/><button>Approve requisition</button></form>}@if(r.Status=="Approved"){<form method="post" action="/admin/procurement/quote">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@r.Id"/><label>Supplier</label><select name="supplier">@foreach(Supplier s in ViewBag.Suppliers){<option value="@s.Id">@s.Name</option>}</select><input name="reference" placeholder="Supplier quote reference" required/><label>Valid until</label><input name="until" type="date" required/>@foreach(var l in r.Lines){<label>@l.Sku.SKU: unit cost for @l.Quantity units</label><input name="lineId" type="hidden" value="@l.Id"/><input name="cost" type="number" min="0" step="0.01" required/>}<button>Record quotation</button></form>}<h3>Quotation comparison (lowest total first)</h3><table><tr><th>Supplier</th><th>Total</th><th>Valid until</th><th>Status / action</th></tr>@foreach(var q in quotes.Where(x=>x.PurchaseRequisitionId==r.Id)){<tr><td>@q.Supplier.Name</td><td>@q.Total</td><td>@q.ValidUntil.ToString("d")</td><td>@q.Status @if(r.Status=="Approved"&&q.Status=="Submitted"){<form action="/admin/procurement/award" method="post">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@q.Id"/><button>Award & create PO</button></form>}</td></tr>}</table></details>}
<h2>Partial goods receive / supplier return</h2>@foreach(PurchaseOrder p in ViewBag.Purchases){<details class="panel"><summary>@p.Number · @p.Status · Received @p.ReceivedTotal · Returned @p.ReturnedTotal · Paid @p.Paid</summary>@if(p.Status is "Approved" or "PartReceived"){<form method="post" action="/admin/procurement/receive">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@p.Id"/><input name="reference" required value="@("GR-"+Guid.NewGuid().ToString("N")[..12])"/>@foreach(var l in p.Lines){<label>@l.Sku.SKU · remaining @(l.Quantity-l.ReceivedQuantity)</label><input name="lineId" type="hidden" value="@l.Id"/><input name="quantity" type="number" min="0" max="@(l.Quantity-l.ReceivedQuantity)" value="0"/>}<button>Receive selected quantities</button></form>}@foreach(var l in p.Lines.Where(x=>x.ReceivedQuantity>x.ReturnedQuantity)){<form method="post" action="/admin/procurement/return" class="panel">@Html.AntiForgeryToken()<strong>Return @l.Sku.SKU to supplier</strong><input name="lineId" type="hidden" value="@l.Id"/><input name="quantity" type="number" min="1" max="@(l.ReceivedQuantity-l.ReturnedQuantity)" value="1"/><input name="reference" required value="@("PR-"+Guid.NewGuid().ToString("N")[..12])"/><input name="reason" required placeholder="Reason"/><button>Post supplier return</button></form>}</details>}
