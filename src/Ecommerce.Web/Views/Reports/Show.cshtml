@model TableVm
@inject Ecommerce.Infrastructure.BrandingService Branding
@{Layout="_AdminLayout"; var brand=await Branding.GetAsync();}
<div class="report-brand">@if(!string.IsNullOrWhiteSpace(brand.LogoUrl)){<img src="@brand.LogoUrl" alt="@brand.CompanyName"/>}<div><strong>@brand.CompanyName</strong><div class="report-address">@brand.ReportAddress</div><div class="report-address">@brand.Phone</div></div></div>
<h1>@Model.Title</h1><form method="get" class="inline no-print"><label>From<input name="from" type="date" value="@Context.Request.Query["from"]"/></label><label>To<input name="to" type="date" value="@Context.Request.Query["to"]"/></label><label>Warehouse ID<input name="warehouseId" value="@Context.Request.Query["warehouseId"]"/></label><label>Status<input name="status" value="@Context.Request.Query["status"]"/></label>@foreach(var filter in new[]{"branchId","categoryId","productId","customerId","supplierId","orderStatus","paymentStatus","paymentMethod","deliveryStatus"}){<label>@filter<input name="@filter" value="@Context.Request.Query[filter]"/></label>}<button>Apply</button><button name="format" value="csv">CSV</button><button name="format" value="xlsx">Excel</button><button name="format" value="pdf">Download PDF</button><button type="button" onclick="window.print()">Print / Save PDF</button></form><p class="muted">Only use filters applicable to the selected report; IDs come from master records. UTC dates. Maximum 10,000 detail rows. Inventory reports show current balances; financial statements use journal dates. Balance sheet should be run with only an end date.</p><div class="table-wrap"><table><thead><tr>@foreach(var c in Model.Columns){<th>@c</th>}</tr></thead><tbody>@foreach(var r in Model.Rows){<tr>@foreach(var c in r){<td>@c</td>}</tr>}</tbody></table></div><p class="report-address">@brand.ReportFooter</p>
