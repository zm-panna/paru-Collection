@model List<CartItem>
@{Layout="_AdminLayout";}
<h1>Point of sale</h1><form method="post" action="/admin/pos/scan" class="inline">@Html.AntiForgeryToken()<input name="barcode" autofocus placeholder="Scan barcode then Enter" required/><button>Add scanned item</button></form><p>Cash sale · Central stock · Server-calculated prices and VAT</p><form method="post" action="/admin/pos/add" class="panel inline">@Html.AntiForgeryToken()<select name="skuId">@foreach(ProductSku s in ViewBag.Skus){<option value="@s.Id">@s.SKU · @s.Barcode · @s.Name · BDT @s.SalePrice</option>}</select><input name="quantity" type="number" min="1" value="1"/><button>Add item</button></form><table><tr><th>SKU</th><th>Qty</th><th>Amount before tax</th><th></th></tr>@foreach(var c in Model){<tr><td>@c.Sku.SKU</td><td>@c.Quantity</td><td>@(c.Quantity*c.Sku.SalePrice)</td><td><form action="/admin/pos/remove" method="post">@Html.AntiForgeryToken()<input name="skuId" type="hidden" value="@c.SkuId"/><button class="outline">Remove</button></form></td></tr>}</table><form method="post" action="/admin/pos/sale" class="panel">@Html.AntiForgeryToken()<input name="key" type="hidden" value="@ViewBag.Key"/><label>Store / warehouse</label><select name="warehouseId">@foreach(Warehouse w in ViewBag.Warehouses){<option value="@w.Id">@w.Name</option>}</select><input name="name" required placeholder="Customer name"/><input name="phone" required placeholder="Customer phone"/><input name="coupon" placeholder="Coupon / discount code"/><label>Payment<select name="method"><option>Cash</option><option>Card</option><option>MFS</option></select></label><input name="reference" placeholder="Verified terminal reference (Card/MFS)" maxlength="100"/><p>Confirm cash received, or independently verify Card/MFS collection in your merchant terminal before recording. This form does not charge a card.</p><button>Complete sale & print invoice</button></form>
