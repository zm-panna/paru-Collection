@model List<PaymentReconciliation>
@{Layout="_AdminLayout";}
<h1>Vouchers & reconciliation</h1><div class="two-col"><form method="post" action="/admin/finance/voucher" class="panel">@Html.AntiForgeryToken()<h2>Cash voucher</h2><select name="type"><option>Receipt</option><option>Payment</option><option>Contra</option></select><label>Offset account (contra uses gateway clearing)</label><select name="account">@foreach(AccountHead a in ViewBag.Heads){<option value="@a.Code">@a.Code @a.Name</option>}</select><input name="party" placeholder="Customer / supplier ID"/><input name="amount" type="number" step="0.01" min="0.01" required/><input name="description" required placeholder="Description"/><button>Post balanced voucher</button></form><form method="post" action="/admin/finance/bank" class="panel">@Html.AntiForgeryToken()<h2>Statement line matching</h2><input name="reference" required placeholder="Bank statement reference"/><input name="date" type="date" required/><input name="amount" type="number" step="0.01" required placeholder="Signed amount (deposit positive)"/><input name="lineId" placeholder="Matching cash/bank journal line ID (optional)"/><button>Record & validate match</button></form></div>
<h2>Payment reconciliation</h2><form method="post" action="/admin/finance/payment" class="panel">@Html.AntiForgeryToken()<select name="id">@foreach(PaymentTransaction p in ViewBag.Payments){<option value="@p.Id">@p.TransactionId · @p.Amount · @p.Status</option>}</select><input name="amount" type="number" step="0.01" min="0" required/><input name="reference" required placeholder="External statement reference"/><button>Compare with recorded collection</button></form><table><tr><th>Transaction</th><th>External amount</th><th>Reference</th><th>Result</th></tr>@foreach(var r in Model){<tr><td>@r.PaymentTransaction.TransactionId</td><td>@r.ExternalAmount</td><td>@r.ExternalReference</td><td>@r.Status</td></tr>}</table><h2>Statement register</h2><table><tr><th>Date</th><th>Reference</th><th>Amount</th><th>Status</th></tr>@foreach(BankStatementLine b in ViewBag.Bank){<tr><td>@b.Date</td><td>@b.Reference</td><td>@b.Amount</td><td>@b.Status</td></tr>}</table>
