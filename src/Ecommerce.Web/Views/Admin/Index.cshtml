@model Dictionary<string,string>
@{Layout="_AdminLayout";ViewData["Title"]="Overview";}
<span class="eyebrow">YOUR BUSINESS, AT A GLANCE</span><h1>Workspace overview</h1><p class="muted">Live transaction totals · UTC reporting dates</p><div class="metric-grid">@foreach(var m in Model){<article class="metric"><small>@m.Key</small><strong>@m.Value</strong><span>From your database</span></article>}</div><section class="panel"><h2>Workflows</h2><p>Purchase → approval → goods receive → supplier payment</p><p>Order → reservation → packing → shipment → delivery → collection</p><p>Return request → inspection → stock decision → external refund recording</p></section>

<div class="two-col">@foreach(var chart in new[]{("Delivered orders by placement date",(List<(string Label,decimal Value)>)ViewBag.Daily),("Order status · last 30 days",(List<(string Label,decimal Value)>)ViewBag.Statuses)}){<section class="panel"><h2>@chart.Item1</h2>@if(chart.Item2.Count==0){<p class="muted">No transactions in this period.</p>}else{var max=chart.Item2.Max(x=>x.Value);@foreach(var row in chart.Item2){<div class="chart-row"><span>@row.Label</span><div><i style="width:@((max==0?0:100*row.Value/max).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))%"></i></div><strong>@row.Value.ToString("N0")</strong></div>}}</section>}</div>

@{var extra=new[]{("Monthly delivered orders by placement date",ViewBag.Monthly),("Category gross sales · 12 months",ViewBag.CategorySales),("Top products · 12 months",ViewBag.TopProducts),("Payment methods · collected",ViewBag.PaymentMethods),("New buyers by first order month",ViewBag.CustomerGrowth)};}
<div class="two-col">@foreach(var chart in extra){if(chart.Item2 is List<(string Label,decimal Value)> rows){<section class="panel"><h2>@chart.Item1</h2>@if(rows.Count==0){<p>No data.</p>}else{var max=rows.Max(x=>x.Value);foreach(var row in rows){<div class="chart-row"><span>@row.Label</span><div><i style="width:@((max==0?0:100*row.Value/max).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))%"></i></div><strong>@row.Value.ToString("N0")</strong></div>}}</section>}}</div>
