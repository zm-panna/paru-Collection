@model Order
<h1>Invoice / @Model.Number</h1><p><span class="status">@Model.Status</span> Payment: @Model.PaymentStatus · @Model.PaymentMethod</p><div class="two-col"><p><strong>@Model.CustomerName</strong><br/>@Model.Phone<br/>@Model.ShippingAddress</p><p>Placed: @Model.CreatedAt.ToString("u")<br/>Source: @Model.Source</p></div><table><tr><th>Item</th><th>Quantity</th><th>Price</th><th>Amount</th></tr>@foreach(var l in Model.Lines){<tr><td>@l.Name</td><td>@l.Quantity</td><td>@l.Price.ToString("N2")</td><td>@((l.Quantity*l.Price).ToString("N2"))</td></tr>}</table><div class="summary"><p>Subtotal @Model.Subtotal.ToString("N2") · Discount @Model.Discount.ToString("N2")</p><p>VAT @Model.Tax.ToString("N2") · Shipping @Model.Shipping.ToString("N2")</p><h2>Total BDT  @Model.Total.ToString("N2")</h2></div><button class="no-print" onclick="window.print()">Print / Save PDF</button>@if(Model.PaymentMethod=="SSLCommerz"&&Model.PaymentStatus!="Paid"&&Model.Status!=OrderStatus.Cancelled){<form method="post" action="/payment/start" class="no-print">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@Model.Id"/><button>Pay securely with SSLCommerz</button></form>}
<h2>Order tracking</h2><ol class="timeline">@foreach(var h in Model.History.OrderBy(x=>x.CreatedAt)){<li><strong>@h.Status</strong> · @h.CreatedAt.ToString("g") UTC <p>@h.Note</p></li>}</ol>
@if(Model.Status==OrderStatus.Delivered&&ViewBag.CanReturn==true){<section class="panel no-print"><h2>Request a return</h2><form method="post" action="/orders/return">@Html.AntiForgeryToken()<select name="lineId">@foreach(var l in Model.Lines){<option value="@l.Id">@l.Name</option>}</select><input name="quantity" type="number" min="1" value="1"/><textarea name="reason" required placeholder="Reason for return"></textarea><button>Submit return request</button></form></section>}
<h2>Returns & refunds</h2>@foreach(ReturnRequest r in ViewBag.Returns){<p>@r.Reason · @r.Quantity item(s) · @r.Status</p>}@foreach(PaymentRefund r in ViewBag.Refunds){<p>Refund BDT @r.Amount · @r.Status · @r.ExternalReference</p>}

<h2>Courier history</h2>@foreach(DeliveryHistory d in ViewBag.Deliveries){<p>@d.CreatedAt.ToString("u") · @d.Status · @d.Note</p>}

@if(ViewBag.Allocations is List<OrderAllocation> allocations&&allocations.Count>0){<h2>Fulfilment locations</h2><table><tr><th>Item</th><th>Location</th><th>Quantity</th><th>Returned to stock</th></tr>@foreach(var a in allocations){<tr><td>@a.OrderLine.Name</td><td>@a.Warehouse.Name</td><td>@a.Quantity</td><td>@a.RestockedQuantity</td></tr>}</table>}
