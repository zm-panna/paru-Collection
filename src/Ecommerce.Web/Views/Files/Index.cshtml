@model Product
@{Layout="_AdminLayout";}
<h1>Images · @Model.Name</h1><div class="gallery">@foreach(var f in Model.Files){<figure>@if(f.FileType=="application/pdf"){<a href="@f.FilePath">PDF document</a>}else{<img src="@f.FilePath" alt="@Model.Name"/>}<figcaption>@f.FileName @(f.IsPrimary?"· Primary":"")</figcaption></figure>}</div><form class="panel" method="post" action="/admin/files/upload" enctype="multipart/form-data">@Html.AntiForgeryToken()<input name="productId" type="hidden" value="@Model.Id"/><label>PNG, JPEG or WebP · max 5 MB</label><input type="file" name="file" accept="image/png,image/jpeg,image/webp" required/><label><input name="primary" type="checkbox" value="true"/>Primary image</label><button>Upload image</button></form>

<form class="panel" action="/admin/files/document" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<h2>Product manual/document</h2><input name="productId" type="hidden" value="@Model.Id"/><input name="file" type="file" accept="application/pdf" required/><p>PDF only, max 10 MB. Product documents are public downloads; do not upload confidential files.</p><button>Upload document</button></form>

<a class="button" href="/admin/files/labels/@Model.Id">Print barcode labels</a><h2>Image order</h2>@foreach(var file in Model.Files){<form method="post" action="/admin/files/sort" class="inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@file.Id"/><span>@file.FileName</span><input type="number" name="sortOrder" value="@file.SortOrder"/><label><input type="checkbox" name="primary" value="true" checked="@file.IsPrimary"/>Primary</label><button>Save</button></form>}
