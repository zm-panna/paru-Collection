@model Product
@{ViewData["Title"]=string.IsNullOrEmpty(Model.MetaTitle)?Model.Name:Model.MetaTitle;ViewData["Description"]=Model.MetaDescription;var stocks=(Dictionary<Guid,int>)ViewBag.Stock;}
<p class="breadcrumb"><a href="/">Shop</a> / @Model.Category.Name / @Model.Name</p><div class="product-detail"><div><img class="detail-image" src="@(Model.Files.Where(x=>x.FileType!="application/pdf").OrderByDescending(x=>x.IsPrimary).FirstOrDefault()?.FilePath??"/images/fallback.svg")" alt="@Model.Name"/><div class="gallery">@foreach(var f in Model.Files.Where(x=>x.FileType!="application/pdf")){<a href="@f.FilePath"><img src="@f.FilePath" alt="@Model.Name"/></a>}</div></div><div><span class="eyebrow">@Model.Category.Name</span><h1>@Model.Name</h1><p>@Model.Description</p><form action="/cart/add" method="post">@Html.AntiForgeryToken()<label>Choose variant</label><select name="skuId">@foreach(var s in Model.Skus.Where(x=>x.Active)){<option value="@s.Id">@s.Name · @s.Color @s.Size · BDT @s.SalePrice · Available: @stocks.GetValueOrDefault(s.Id)</option>}</select><label>Quantity</label><input type="number" name="quantity" min="1" max="10000" value="1"/><button>Add to shopping bag</button></form><form method="post" action="/customer/wishlist">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Id"/><button class="outline">Save / remove wishlist</button></form><hr/><p><strong>Return policy:</strong> @Model.ReturnPolicy</p><p><strong>Warranty:</strong> @Model.Warranty</p><p><small>Product code @Model.Code</small></p></div></div>
<section><h2>Customer reviews</h2>@foreach(Review r in ViewBag.Reviews){<div class="panel"><strong>@r.Rating / 5 @(r.VerifiedPurchase?"· Verified purchase":"")</strong><p>@r.Comment</p></div>}@if(User.Identity?.IsAuthenticated==true){<form method="post" action="/customer/review" class="panel">@Html.AntiForgeryToken()<input name="productId" value="@Model.Id" type="hidden"/><label>Your rating</label><select name="rating">@for(int i=5;i>=1;i--){<option value="@i">@i stars</option>}</select><textarea name="comment" maxlength="2000" required placeholder="Share your experience"></textarea><button>Submit for moderation</button></form>}</section><section><h2>Related products</h2><div class="categories">@foreach(Product p in ViewBag.Related){<a href="/product/@p.Slug">@p.Name</a>}</div></section>

<h2>Product documents</h2>@foreach(var f in Model.Files.Where(x=>x.FileType=="application/pdf")){<p><a href="@f.FilePath">Download PDF manual</a></p>}

@{var offers=Model.Skus.Where(x=>x.Active).Select(x=>new Dictionary<string,object?>{{"@type","Offer"},{"sku",x.SKU},{"price",x.SalePrice},{"priceCurrency","BDT"},{"url",ViewData["Canonical"]},{"availability",((Dictionary<Guid,int>)ViewBag.Stock).GetValueOrDefault(x.Id)>0?"https://schema.org/InStock":"https://schema.org/OutOfStock"}});var structured=new Dictionary<string,object?>{{"@context","https://schema.org"},{"@type","Product"},{"name",Model.Name},{"description",Model.Description},{"sku",Model.Code},{"offers",offers}};}
<script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(structured))</script>
