@model List<Microsoft.AspNetCore.Identity.IdentityUser>
@{Layout="_AdminLayout";var memberships=(Dictionary<string,string>)ViewBag.Memberships;}
<h1>Users & roles</h1><p>Customers register through the storefront. Staff access is granted here. SuperAdmin is provisioned through setup.</p><form method="post" action="/admin/security/role" class="inline">@Html.AntiForgeryToken()<input name="name" placeholder="New role name" required/><button>Create role</button></form><div class="table-wrap"><table><tr><th>User</th><th>Roles</th><th>Assignment</th></tr>@foreach(var u in Model){<tr><td>@u.Email</td><td>@memberships[u.Id]</td><td><form action="/admin/security/assign" method="post" class="inline">@Html.AntiForgeryToken()<input name="userId" type="hidden" value="@u.Id"/><select name="role">@foreach(string r in ViewBag.Roles){if(r!="SuperAdmin"){<option>@r</option>}}</select><select name="remove"><option value="false">Add</option><option value="true">Remove</option></select><button>Apply</button></form></td></tr>}</table></div><a href="/admin/data/permissions">Manage role permissions and user overrides →</a>
