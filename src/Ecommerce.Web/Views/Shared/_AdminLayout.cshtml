@inject Ecommerce.Infrastructure.BrandingService Branding
@{ var brand = await Branding.GetAsync(); }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · @brand.CompanyName</title>@if(brand.FaviconUrl!=""){<link rel="icon" href="@brand.FaviconUrl"/>}<link rel="stylesheet" href="~/lib/bootstrap.min.css"/><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><style>:root{--green:@brand.PrimaryColor;--accent:@brand.AccentColor;--paper:@brand.BackgroundColor}</style></head><body class="admin-body"><partial name="_TopNavbar"/><div class="admin-shell"><partial name="_AdminSidebar"/><main class="admin-main">@if(TempData["Message"] is {} message){<div class="notice">@message</div>}@RenderBody()</main></div><partial name="_AiChatWidget"/>
    <script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
