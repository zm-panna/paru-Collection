@model TableVm
@{Layout="_AdminLayout";ViewData["Title"]=Model.Title;}
<div class="section-head"><h1>@Model.Title</h1><a class="button" href="/admin/data/@Model.Module/edit">Create new +</a></div><form method="get" class="inline"><input name="q" value="@ViewBag.Q" placeholder="Search records"/><button>Search</button></form><p class="muted">50 records per page. Search scans up to the latest 2,000 records.</p><div class="table-wrap"><table><thead><tr>@foreach(var c in Model.Columns.Skip(1)){<th>@c</th>}<th>Actions</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr>@foreach(var cell in row.Skip(1)){<td>@cell</td>}<td><a href="/admin/data/@Model.Module/edit/@row[0]">Edit</a>@if(Model.Module=="products"){<a href="/admin/files/@row[0]">Images</a>}<form method="post" action="/admin/data/@Model.Module/archive">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@row[0]"/><button class="link-button">Archive</button></form></td></tr>}</tbody></table></div><div class="pagination">@if(ViewBag.Page>1){<a href="?page=@(ViewBag.Page-1)&q=@ViewBag.Q">Previous</a>}<span>Page @ViewBag.Page</span><a href="?page=@(ViewBag.Page+1)&q=@ViewBag.Q">Next</a></div>
