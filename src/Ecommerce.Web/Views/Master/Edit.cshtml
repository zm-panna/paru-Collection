@model EditorVm
@{Layout="_AdminLayout";ViewData["Title"]="Edit "+Model.Module;}
<h1>@Model.Module</h1><form method="post" enctype="multipart/form-data" action="/admin/data/@Model.Module/save" class="panel"><div asp-validation-summary="All" class="validation"></div>@Html.AntiForgeryToken()<input name="id" type="hidden" value="@Model.Entity.Id"/><input name="version" type="hidden" value="@Convert.ToBase64String(Model.Entity.Version)"/><div class="form-grid">@foreach(var f in Model.Fields){var value=f.GetValue(Model.Entity);var t=Nullable.GetUnderlyingType(f.PropertyType)??f.PropertyType;<div><label for="@f.Name">@f.Name</label>@if(Model.Choices.TryGetValue(f.Name,out var options)){<select name="@f.Name" id="@f.Name">@if(Nullable.GetUnderlyingType(f.PropertyType)!=null){<option value="">None</option>}@foreach(var o in options){<option value="@o.Id" selected="@(value?.ToString()==o.Id)">@o.Label</option>}</select>}else if(t==typeof(bool)){<input name="@f.Name" id="@f.Name" type="checkbox" value="true" checked="@((bool?)value==true)"/>}else if(t==typeof(DateTime)){<input type="datetime-local" name="@f.Name" id="@f.Name" value="@(((DateTime?)value)?.ToString("yyyy-MM-ddTHH:mm"))"/>}else if(t==typeof(decimal)||t==typeof(int)){<input type="number" step="@(t==typeof(int)?"1":"0.01")" name="@f.Name" id="@f.Name" value="@Convert.ToString(value,System.Globalization.CultureInfo.InvariantCulture)"/>}else{<input name="@f.Name" id="@f.Name" value="@value" maxlength="2000"/>}</div>}</div>@if(Model.Module.Equals("products",StringComparison.OrdinalIgnoreCase)){<div class="product-upload"><label for="productImages">Product images</label><input id="productImages" name="productImages" type="file" accept="image/png,image/jpeg,image/webp" multiple/><small class="muted">PNG/JPEG/WebP, max 5 MB each, up to 8 images. Files are saved under Docs/Inv and links are stored in ProductFile.</small></div>}<button>Save changes</button><a href="/admin/data/@Model.Module">Back to list</a></form>
