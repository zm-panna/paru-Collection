@model List<CartItem>
@{ViewData["Title"]="Shopping bag";}
<h1>Your shopping bag</h1>@if(Model.Count==0){<div class="empty">Your bag is empty. <a href="/">Explore products →</a></div>}else{<div class="table-wrap"><table><thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Sku.Product.Name<br/><small>@c.Sku.Name · @c.Sku.SKU</small></td><td>BDT  @c.Sku.SalePrice.ToString("N2")</td><td><form action="/cart/update" method="post" class="inline">@Html.AntiForgeryToken()<input name="skuId" type="hidden" value="@c.SkuId"/><input name="quantity" type="number" value="@c.Quantity" min="0" max="10000"/><button>Update</button></form></td><td>BDT  @((c.Quantity*c.Sku.SalePrice).ToString("N2"))</td><td><form action="/cart/update" method="post">@Html.AntiForgeryToken()<input name="skuId" type="hidden" value="@c.SkuId"/><input name="quantity" type="hidden" value="0"/><button class="outline">Remove</button></form></td></tr>}</tbody></table></div><div class="summary"><h2>Subtotal BDT  @Model.Sum(x=>x.Quantity*x.Sku.SalePrice).ToString("N2")</h2><p>Coupon, VAT and delivery are calculated when you place the order.</p><a class="button" href="/checkout">Continue to checkout →</a></div>}

@if(Model.Count>0){<form method="post" action="/cart/clear">@Html.AntiForgeryToken()<button class="outline">Clear cart</button></form>}
