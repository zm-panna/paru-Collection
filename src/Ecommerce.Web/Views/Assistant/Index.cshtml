<h1>Ask Paru</h1><p>Find products, check your orders, or ask for help in বাংলা or English.</p><div class="chat panel" id="chat" aria-live="polite"><p class="chat-message">আপনি কী খুঁজছেন? আপনার budget বা product-এর নাম বলুন।</p></div><form id="ai-form" action="/assistant/ask" method="post" class="inline">@Html.AntiForgeryToken()<input name="question" maxlength="2000" required placeholder="৫০০০ টাকার মধ্যে কী আছে?"/><button id="ask-button">Send →</button></form><p class="muted">AI answers may contain errors. Confirm prices and order details on the relevant page.</p>
@section Scripts {<script>document.getElementById('ai-form').addEventListener('submit',async function(e){e.preventDefault();const chat=document.getElementById('chat'),btn=document.getElementById('ask-button');function add(t){let p=document.createElement('p');p.className='chat-message';p.textContent=t;chat.appendChild(p);}add(this.question.value);btn.disabled=true;try{const r=await fetch(this.action,{method:'POST',body:new FormData(this)});if(!r.ok)throw new Error(await r.text());add((await r.json()).reply);this.question.value='';}catch(err){add(err.message);}finally{btn.disabled=false;}});</script>}
