@model List<WishlistItem>
<h1>Wishlist</h1>@foreach(var w in Model){<section class="panel"><a href="/product/@w.Product.Slug">@w.Product.Name</a><form method="post" action="/customer/wishlist-cart" class="inline">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@w.ProductId"/><select name="skuId">@foreach(var s in w.Product.Skus.Where(x=>x.Active)){<option value="@s.Id">@s.Name · BDT @s.SalePrice</option>}</select><button>Move to cart</button></form><form action="/customer/wishlist" method="post">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@w.ProductId"/><button class="outline">Remove</button></form></section>}
